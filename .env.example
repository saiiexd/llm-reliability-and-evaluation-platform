# =====================================================================
# LLM Reliability & Evaluation Platform — Backend Environment Configuration
# =====================================================================

# Filesystem persistence store path (defaults to ./experiments in workspace)
LLM_RELIABILITY_PERSISTENCE_DIR=./experiments

# Allowed origins for CORS (comma-separated or JSON list)
LLM_RELIABILITY_CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://127.0.0.1:5173,http://127.0.0.1:4173

# Application environment: development | test | production
LLM_RELIABILITY_ENVIRONMENT=development

# Debug mode (enables verbose server logging)
LLM_RELIABILITY_DEBUG=false

# Server network binding
LLM_RELIABILITY_HOST=127.0.0.1
LLM_RELIABILITY_PORT=8000

# REST API v1 routing prefix
LLM_RELIABILITY_API_V1_PREFIX=/api/v1

# =====================================================================
# Real LLM Provider Settings (Milestone 8)
# Credentials are ONLY loaded from server environment variables;
# they are NEVER stored in experiment records, run files, or fingerprints.
# =====================================================================

# OpenAI API Key (or standard OPENAI_API_KEY)
OPENAI_API_KEY=
LLM_RELIABILITY_OPENAI_API_KEY=

# Optional custom base URL for OpenAI-compatible local or self-hosted endpoints
# (e.g., http://localhost:11434/v1 for Ollama, http://localhost:8000/v1 for vLLM)
OPENAI_BASE_URL=
LLM_RELIABILITY_OPENAI_BASE_URL=

# Default server-wide permission for live external inference (default: false for safety)
LLM_RELIABILITY_ALLOW_EXTERNAL_INFERENCE=false
