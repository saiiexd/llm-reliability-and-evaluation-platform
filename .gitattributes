# =============================================================================
# Git attributes - line ending normalization
# =============================================================================
# Normalize all text files to LF in the repository.
# On checkout, Windows gets CRLF, Unix/macOS get LF.

* text=auto

# Explicitly declare text files
*.py      text eol=lf
*.md      text eol=lf
*.txt     text eol=lf
*.toml    text eol=lf
*.yaml    text eol=lf
*.yml     text eol=lf
*.json    text eol=lf
*.cfg     text eol=lf
*.ini     text eol=lf
*.rst     text eol=lf
*.sh      text eol=lf
*.bat     text eol=crlf
*.ps1     text eol=crlf
*.gitignore text eol=lf
*.gitattributes text eol=lf

# Binary files - do not process line endings
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.ico     binary
*.pdf     binary
*.pkl     binary
*.pt      binary
*.pth     binary
*.h5      binary
*.hdf5    binary
*.bin     binary
*.ckpt    binary
*.whl     binary
*.zip     binary
*.gz      binary
*.tar     binary
